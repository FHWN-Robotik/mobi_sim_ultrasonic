<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo Harmonic: Differential Drive -->

  <gazebo>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <!-- Left wheels -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <!-- Right wheels -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Robot geometry -->
      <wheel_separation>0.214</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <!-- Input -->
      <topic>/cmd_vel</topic>

      <!-- Odometry -->
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>30</odom_publish_frequency>

    </plugin>

  </gazebo>
  
<!-- Joint States für die Räder -->
    <gazebo>
    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
    </plugin>
    </gazebo>

  <!-- ===================================================== -->
  <!-- LiDAR -->
  <!-- ===================================================== -->

  <gazebo reference="laser_frame">

    <sensor name="rplidar" type="gpu_lidar">
      <topic>/scan</topic>
      <update_rate>30</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>200</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.15</min>
          <max>8.0</max>
        </range>
      </ray>

      <always_on>true</always_on>
      <visualize>true</visualize>

    </sensor>

  </gazebo>

  <!-- ===================================================== -->
  <!-- IMU -->
  <!-- ===================================================== -->

  <gazebo reference="imu_link">

    <sensor name="imu_sensor" type="imu">

      <topic>/imu</topic>

      <update_rate>30</update_rate>

      <always_on>true</always_on>
      <visualize>false</visualize>

    </sensor>

  </gazebo>


  <!-- ===================================================== -->
  <!-- Ultraschallsensoren - ideale Entfernungsmessung       -->
  <!-- ===================================================== -->

  <xacro:macro name="gazebo_ultrasonic"
               params="name roll pitch yaw">

    <gazebo reference="${name}_link">

      <sensor name="${name}_sensor" type="gpu_lidar">

        <!-- Messrichtung relativ zum Sensor-Link -->
        <pose>0 0 0 ${roll} ${pitch} ${yaw}</pose>

        <topic>/ultrasonic/${name}/scan</topic>

        <update_rate>10</update_rate>

        <always_on>true</always_on>
        <visualize>false</visualize>

        <ray>
          <scan>
            <horizontal>
              <samples>9</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.02</min>
            <max>4.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

      </sensor>

    </gazebo>

  </xacro:macro>


    <!-- ===================================================== -->
  <!-- Ultraschallsensoren: korrigierte Messrichtungen       -->
  <!-- ===================================================== -->

    <!-- ===================================================== -->
  <!-- Ultraschallsensoren: mathematisch korrigierte Richtung -->
  <!-- ===================================================== -->

  <!-- Vorne links: +X -->
  <xacro:gazebo_ultrasonic
    name="us_front_left"
    roll="0"
    pitch="-1.57079632679"
    yaw="0"/>

  <!-- Vorne rechts: +X -->
  <xacro:gazebo_ultrasonic
    name="us_front_right"
    roll="0"
    pitch="-1.57079632679"
    yaw="0"/>

  <!-- Hinten links: -X -->
  <xacro:gazebo_ultrasonic
    name="us_rear_left"
    roll="0"
    pitch="-1.57079632679"
    yaw="0"/>

  <!-- Hinten rechts: -X -->
  <xacro:gazebo_ultrasonic
    name="us_rear_right"
    roll="0"
    pitch="-1.57079632679"
    yaw="0"/>

  <!-- Links: +Y -->
  <xacro:gazebo_ultrasonic
    name="us_left"
    roll="0"
    pitch="1.57079632679"
    yaw="0"/>

  <!-- Rechts: -Y -->
  <xacro:gazebo_ultrasonic
    name="us_right"
    roll="0"
    pitch="1.57079632679"
    yaw="0"/>



</robot>