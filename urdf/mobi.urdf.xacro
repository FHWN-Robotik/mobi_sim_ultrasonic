<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobi">

  <!-- Hier werden die Dateien importiert. -->
  <xacro:include filename="$(find mobi_sim_ultrasonic)/urdf/common_properties.xacro" />
  <xacro:include filename="$(find mobi_sim_ultrasonic)/urdf/mobi.gazebo.xacro" />
  <!-- <xacro:include filename="$(find mobi_ros2)/urdf/macro.tower.urdf.xacro" /> -->

  <!-- Farben vom Roboter für RVIZ-->
  <xacro:materials_rviz />

  <!-- Base Koordinatensystem als Referenz -->
  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint" />
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_footprint"/>

  <!-- Mobi Plattform  -->
  
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link" />
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">
      <visual>
	    <origin rpy="0 0 0" xyz="0 0 0.0415" />
      <geometry>
        <box size="0.285 0.198 0.083"/>
      </geometry>
	    <material name="yellow"/>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0415" />
      <geometry>
        <box size="0.285 0.198 0.083"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="10"/>
      <origin rpy="0 0 0" xyz="0 0 0.0415"/>
       <inertia ixx="0.03267" ixy="0" ixz="0" iyy="0.067688" iyz="0" izz="0.100358"/> 
    </inertial>
  </link>

  <!-- ================================================= -->
  <!-- Frontmarkierung zur Erkennung der Fahrtrichtung   -->
  <!-- ================================================= -->

  <joint name="front_marker_joint" type="fixed">
    <parent link="chassis_link"/>
    <child link="front_marker_link"/>
    <origin xyz="0.1475 0 0.045" rpy="0 0 0"/>
  </joint>

  <link name="front_marker_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>

      <geometry>
        <box size="0.010 0.120 0.030"/>
      </geometry>

      <material name="front_blue">
        <color rgba="0.0 0.2 1.0 1.0"/>
      </material>
    </visual>

  </link>

  <!-- 4 Räder werden hier hinzugefügt
  Links vorne 
  Links hinten 
  Rechts vorne 
  Rechts hinten
  -->
  <joint name="front_left_wheel_joint" type="continuous">
        <origin xyz="0.0975 0.107 0.023" rpy="1.5708 0 3.1415"/>
        <parent link="chassis_link"/>
        <child link="front_left_wheel_link"/>
        <axis xyz="0 0 -1"/>
  </joint>

  <link name="front_left_wheel_link">
    <visual>
	    <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
	    <material name="dark_gray"/>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <inertia ixx="0.000167" ixy="0" ixz="0" iyy="0.000167" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
        <origin xyz="-0.0975 0.107 0.023" rpy="1.5708 0 3.1415"/>
        <parent link="chassis_link"/>
        <child link="rear_left_wheel_link"/>
        <axis xyz="0 0 -1"/>
  </joint>

  <link name="rear_left_wheel_link">
    <visual>
	    <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
	    <material name="dark_gray"/>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <inertia ixx="0.000167" ixy="0" ixz="0" iyy="0.000167" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
        <origin xyz="0.0975 -0.107 0.023" rpy="1.5708 0 0"/>
        <parent link="chassis_link"/>
        <child link="front_right_wheel_link"/>
        <axis xyz="0 0 1"/>
  </joint>

  <link name="front_right_wheel_link">
    <visual>
	    <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
	    <material name="dark_gray"/>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <inertia ixx="0.000167" ixy="0" ixz="0" iyy="0.000167" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
        <origin xyz="-0.0975 -0.107 0.023" rpy="1.5708 0 0"/>
        <parent link="chassis_link"/>
        <child link="rear_right_wheel_link"/>
        <axis xyz="0 0 1"/>
  </joint>

  <link name="rear_right_wheel_link">
    <visual>
	    <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
	    <material name="dark_gray"/>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.025" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <inertia ixx="0.000167" ixy="0" ixz="0" iyy="0.000167" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- Obere Abschnitt von Mobi  -->
  

  <joint name="housing_joint" type="fixed">
        <origin xyz="0 0 0.083" rpy="0 0 0"/>
        <parent link="chassis_link"/>
        <child link="housing_link"/>
  </joint>

  <link name="housing_link">
    <visual>
	    <origin xyz="0 0 0.03575" rpy="0 0 0" />
      <geometry>
        <box size="0.167 0.1556 0.0715"/>  
      </geometry>
	    <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="cylinder_1_joint" type="fixed">
        <origin xyz="0.05 0.05 0.0715" rpy="0 0 0"/>
        <parent link="housing_link"/>
        <child link="cylinder_1_link"/>
  </joint>

  <link name="cylinder_1_link">
    <visual>
	    <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.05"/>
      </geometry>
	    <material name="light_gray"/>
    </visual>
  </link>

  <joint name="cylinder_2_joint" type="fixed">
        <origin xyz="-0.05 0.05 0.0715" rpy="0 0 0"/>
        <parent link="housing_link"/>
        <child link="cylinder_2_link"/>
  </joint>

  <link name="cylinder_2_link">
    <visual>
	    <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.05"/>
      </geometry>
	    <material name="light_gray"/>
    </visual>
  </link>

  <joint name="cylinder_3_joint" type="fixed">
        <origin xyz="0.05 -0.05 0.0715" rpy="0 0 0"/>
        <parent link="housing_link"/>
        <child link="cylinder_3_link"/>
  </joint>

  <link name="cylinder_3_link">
    <visual>
	    <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.05"/>
      </geometry>
	    <material name="light_gray"/>
    </visual>
  </link>

  <joint name="cylinder_4_joint" type="fixed">
        <origin xyz="-0.05 -0.05 0.0715" rpy="0 0 0"/>
        <parent link="housing_link"/>
        <child link="cylinder_4_link"/>
  </joint>

  <link name="cylinder_4_link">
    <visual>
	    <origin xyz="0 0 0.025" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.05"/>
      </geometry>
	    <material name="light_gray"/>
    </visual>
  </link>

  <joint name="plate_joint" type="fixed">
        <origin xyz="0 0 0.1215" rpy="0 0 0"/>
        <parent link="housing_link"/>
        <child link="plate_link"/>
  </joint>

  <link name="plate_link">
    <visual>
	    <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <box size="0.150 0.150 0.012"/>  
      </geometry>
	    <material name="light_gray"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
        <origin xyz="0 0 0.012" rpy="0 0 0"/>
        <parent link="plate_link"/>
        <child link="lidar_link"/>
  </joint>

  <link name="lidar_link">
    <visual>
	    <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0375" length="0.04"/>
      </geometry>
	    <material name="gray"/>
    </visual>
  </link>

  <!-- Hier werden Links für die Sensoren definiert. -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="housing_link"/>
    <child link="imu_link"/>
  </joint>

  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <parent link="lidar_link"/>
    <child link="laser_frame"/>
  </joint>

  <link name="laser_frame"/>

  
<!-- ====================================================== -->
<!-- Ultraschallsensoren am oberen Gehäuse von Mobi         -->
<!-- 6 runde, hellgraue Sensorköpfe                         -->
<!-- ====================================================== -->

<xacro:macro name="ultrasonic_sensor"
             params="name x y z roll pitch yaw offset_axis">

  <!-- Befestigung am oberen grauen Gehäuse -->
  <joint name="${name}_joint" type="fixed">
    <parent link="housing_link"/>
    <child link="${name}_link"/>

    <origin xyz="${x} ${y} ${z}"
            rpy="${roll} ${pitch} ${yaw}"/>
  </joint>

<!-- Ultraschallsensor mit zwei Schallwandlern -->

<link name="${name}_link">

  <!-- Schallwandler 1 -->
  <visual>
    <origin xyz="${-0.007 if offset_axis == 'x' else 0}
       ${-0.007 if offset_axis == 'y' else 0}
       0"
    rpy="0 0 0"/>

    <geometry>
      <cylinder radius="0.006" length="0.005"/>
    </geometry>

    <material name="ultrasonic_light_gray">
      <color rgba="0.8 0.8 0.8 1.0"/>
    </material>

  </visual>

  <!-- Schallwandler 2 -->
  <visual>
    <origin
      xyz="${0.007 if offset_axis == 'x' else 0}
        ${0.007 if offset_axis == 'y' else 0}
        0"
      rpy="0 0 0"/> 

    <geometry>
      <cylinder radius="0.006" length="0.005"/>
    </geometry>

    <material name="ultrasonic_light_gray">
      <color rgba="0.8 0.8 0.8 1.0"/>
    </material>

  </visual>

</link>

</xacro:macro>

<!-- ======================================= -->
<!-- VORNE: Zwei Ultraschallsensoren         -->
<!-- ======================================= -->

<xacro:ultrasonic_sensor
  name="us_front_left"
  x="0.086"
  y="0.035"
  z="0.035"
  roll="0"
  pitch="1.5708"
  yaw="0"
  offset_axis="y"/>

<xacro:ultrasonic_sensor
  name="us_front_right"
  x="0.086"
  y="-0.035"
  z="0.035"
  roll="0"
  pitch="1.5708"
  yaw="0"
  offset_axis="y"/>


<!-- ======================================= -->
<!-- HINTEN: Zwei Ultraschallsensoren        -->
<!-- ======================================= -->

<xacro:ultrasonic_sensor
  name="us_rear_left"
  x="-0.086"
  y="0.035"
  z="0.035"
  roll="0"
  pitch="-1.5708"
  yaw="0"
  offset_axis="y"/>

<xacro:ultrasonic_sensor
  name="us_rear_right"
  x="-0.086"
  y="-0.035"
  z="0.035"
  roll="0"
  pitch="-1.5708"
  yaw="0"
  offset_axis="y"/>


<!-- ======================================= -->
<!-- SEITLICH: Je ein Ultraschallsensor      -->
<!-- ======================================= -->

<xacro:ultrasonic_sensor
  name="us_left"
  x="0"
  y="0.080"
  z="0.035"
  roll="1.5708"
  pitch="0"
  yaw="0"
  offset_axis="x"/>

<xacro:ultrasonic_sensor
  name="us_right"
  x="0"
  y="-0.080"
  z="0.035"
  roll="-1.5708"
  pitch="0"
  yaw="0"
  offset_axis="x"/>

  <!-- ===================================================== -->
  <!-- Lokale Koordinatensysteme der Ultraschallsensoren     -->
  <!-- X-Achse: Messrichtung                                 -->
  <!-- Y-Achse: seitlich zur Messrichtung                     -->
  <!-- Z-Achse: nach oben                                    -->
  <!-- ===================================================== -->

  <xacro:macro name="ultrasonic_range_frame"
               params="name x y z yaw">

    <joint name="${name}_range_joint" type="fixed">

      <parent link="housing_link"/>
      <child link="${name}_range_frame"/>

      <origin
        xyz="${x} ${y} ${z}"
        rpy="0 0 ${yaw}"/>

    </joint>

    <link name="${name}_range_frame"/>

  </xacro:macro>


    <!-- ===================================================== -->
  <!-- Vordere Ultraschallsensoren                           -->
  <!-- ===================================================== -->

  <xacro:ultrasonic_range_frame
    name="us_front_left"
    x="0.086"
    y="0.035"
    z="0.035"
    yaw="0"/>

  <xacro:ultrasonic_range_frame
    name="us_front_right"
    x="0.086"
    y="-0.035"
    z="0.035"
    yaw="0"/>


  <!-- ===================================================== -->
  <!-- Hintere Ultraschallsensoren                           -->
  <!-- ===================================================== -->

  <xacro:ultrasonic_range_frame
    name="us_rear_left"
    x="-0.086"
    y="0.035"
    z="0.035"
    yaw="3.14159265359"/>

  <xacro:ultrasonic_range_frame
    name="us_rear_right"
    x="-0.086"
    y="-0.035"
    z="0.035"
    yaw="3.14159265359"/>


  <!-- ===================================================== -->
  <!-- Seitliche Ultraschallsensoren                         -->
  <!-- ===================================================== -->

  <xacro:ultrasonic_range_frame
    name="us_left"
    x="0"
    y="0.080"
    z="0.035"
    yaw="1.57079632679"/>

  <xacro:ultrasonic_range_frame
    name="us_right"
    x="0"
    y="-0.080"
    z="0.035"
    yaw="-1.57079632679"/>


</robot>
